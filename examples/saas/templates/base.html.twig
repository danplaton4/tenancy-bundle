<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{% block title %}Tenancy Demo{% endblock %}</title>
    <style>
      :root { --brand-color: {% block brand_color %}#0f172a{% endblock %}; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; margin: 0; padding: 0; color: #0f172a; background: #f8fafc; }
      header { background: var(--brand-color); color: white; padding: 1.5rem 2rem; }
      main { max-width: 64rem; margin: 2rem auto; padding: 0 2rem; }
      h1 { margin: 0; font-size: 1.75rem; }
      ul { list-style: none; padding: 0; }
      li { padding: 1rem; background: white; margin-bottom: 0.5rem; border-radius: 4px; border-left: 4px solid var(--brand-color); }
      a { color: var(--brand-color); }
      .meta { font-size: 0.875rem; color: #64748b; }
    </style>
    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    <header><h1>{% block heading %}Tenancy Demo{% endblock %}</h1></header>
    <main>{% block body %}{% endblock %}</main>
  </body>
</html>
