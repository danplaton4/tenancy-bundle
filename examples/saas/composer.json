{
    "name": "danplaton4/tenancy-demo-saas",
    "description": "Symfony 7.4 multi-tenant demo app — database-per-tenant with FrankenPHP + Caddy + MariaDB.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true,
                "versions": {
                    "danplaton4/tenancy-bundle": "0.3.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "danplaton4/tenancy-bundle": "@dev",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "league/flysystem-bundle": "^3.7",
        "league/flysystem-memory": "^3.31",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": false
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "auto-scripts": {}
    }
}
