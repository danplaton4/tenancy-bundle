# phpstan-extension-dogfood.neon
#
# Dogfood (WITH Doctrine): runs the wired tenancy PHPStan rules (extension-doctrine.neon)
# against the bundle's own src/ with phpstan/phpstan-doctrine present. Exercises the D-02
# "metadata path" end-to-end: ObjectMetadataResolver is injected into TenantIdDriftRule
# (WR-01 wiring) and the CR-01-fixed checkViaMetadata() runs over the bundle's own
# #[TenantAware] entities — proving ZERO false positives through the resolver path.
#
# Includes ONLY extension-doctrine.neon (the standalone wired fragment) — NOT base
# extension.neon. This ensures exactly one TenantIdDriftRule is registered. PHPStan's
# Nette DI does not dedupe phpstan.rules.rule by class; including both would double-fire.
#
# Purpose: standing CI protection for the wired metadata path (truth #10).
# For the no-doctrine path, see phpstan-extension-dogfood-nodoctrine.neon.
#
# Keep this config ENTIRELY SEPARATE from phpstan.neon (level-9 self-analysis).
# phpstan.neon MUST NOT include extension.neon or extension-doctrine.neon (Pitfall 4).

includes:
    - extension-doctrine.neon

parameters:
    level: 9
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            identifier: trait.unused
            reportUnmatched: false
    parallel:
        maximumNumberOfProcesses: 1
